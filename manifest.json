{
  "manifest_version": 3,
  "name": "無限煉製 · 煉製軌跡 v1.2.0",
  "version": "1.2.0",
  "version_name": "v1.2.0",
  "description": "跨帳號共用的配方表：成功、崩解、祈禱全記，合成前先告訴你結果，並依你手上的材料算出怎麼煉。資料只存在本機。",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://pillars-of-creation.funtuan.work/*", "https://api.github.com/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://pillars-of-creation.funtuan.work/*"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://pillars-of-creation.funtuan.work/*"],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/overlay.js"],
      "matches": ["https://pillars-of-creation.funtuan.work/*"]
    }
  ],
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "煉製軌跡"
  }
}
